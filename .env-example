# Copy this file to .env and fill in real values locally.
# .env is git-ignored; never commit real secrets. See docs/tasks.md Appendix A.

# Gmail API (OAuth 2.0) — set up in Chapter 9 / Stage 7
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# LLM provider (Chapter 6 / Stage 4) — only needed for claude_api / claude_cli trash-talk modes
ANTHROPIC_API_KEY=

# Gemini tactical agent - required by `peer` and `play` modes containing an Agent.
# Create a key in Google AI Studio. Human vs Human does not require it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Bound each tactical request so a slow provider cannot consume the network turn timeout.
GEMINI_TIMEOUT_SECONDS=8
# Optional: set true to try the documented backup models after the configured model fails.
GEMINI_ENABLE_MODEL_FALLBACKS=false
